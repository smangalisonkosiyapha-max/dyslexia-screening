{
  "expo": {
    "name": "CogniCare Dyslexia",
    "slug": "cognicare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cognicare.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CogniCare Dyslexia uses your location to suggest nearby Disability Unit and learning support resources."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "package": "com.cognicare.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C63FF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CogniCare Dyslexia to access your location to find nearby support resources."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "cognicare",
    "extra": {
      "eas": {
        "projectId": "db575178-e32c-405e-8578-cde50c18faae"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/db575178-e32c-405e-8578-cde50c18faae"
    }
  }
}
